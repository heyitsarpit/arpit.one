{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.*.js",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/node_modules",
      "!components/archive",
      "!data/spotify-playlists.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "includes": [
      "**",
      "!**/.*.js",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/node_modules",
      "!components/archive",
      "!data/spotify-playlists.json"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "performance": {},
      "correctness": {
        "noInvalidBuiltinInstantiation": "error",
        "noUndeclaredVariables": "error",
        "noUnusedVariables": "warn",
        "useHookAtTopLevel": "error",
        "noUnusedImports": "error"
      },
      "nursery": {
        // "useComponentExportOnlyModules": "error",
      },
      "style": {
        "noNamespace": "error",
        "useArrayLiterals": "warn"
      },
      "suspicious": {
        "noDebugger": "error",
        "noEmptyBlockStatements": "info",
        "noUnknownAtRules": "off"
      }
    },
    "includes": [
      "**",
      "!**/.*.js",
      "!**/dist",
      "!**/build",
      "!**/.next",
      "!**/node_modules",
      "!components/archive",
      "!data/spotify-playlists.json"
    ]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": true,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    },
    "globals": ["React", "JSX"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
