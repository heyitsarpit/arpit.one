{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "mdx": ["./mdx.ts"],
      "@/components/*": ["./components/*"],
      "@/utils/*": ["./utils/*"],
      "@/data/*": ["./data/*"],
      "@/public/*": ["./public/*"],
      "@/styles/*": ["./styles/*"]
    },
    "incremental": true
  },
  "exclude": ["node_modules", "components/archive/**", "data/artCuration.ts"],
  "include": ["next-env.d.ts", "mdx.ts", "**/*.ts", "**/*.tsx"]
}
